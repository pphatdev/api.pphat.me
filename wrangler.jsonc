/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog-api",
	"main": "apps/app.ts",
	"compatibility_date": "2026-04-15",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 *
	 * Secrets (set via `wrangler secret put <NAME>`):
	 *   GITHUB_CLIENT_SECRET
	 *   GOOGLE_CLIENT_SECRET
	 *   JWT_SECRET
	 */
	"vars": {
		"GITHUB_CLIENT_ID": "Ov23li3Ck51xqMVZd7Ob",
		"GOOGLE_CLIENT_ID": "",
		"APP_URL": "https://api.pphat.me",
		// SMTP settings for email 2FA (use wrangler secret put for SMTP_PASS)
		"SMTP_HOST": "smtp.gmail.com",
		"SMTP_PORT": "587",
		"SMTP_USER": "Sophat L. <info.sophat@gmail.com>",
		"SMTP_FROM": "info.sophat@gmail.com"
	},
	/**
	 * Secrets (set via `wrangler secret put <NAME>`):
	 *   SMTP_PASS
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
	/**
	 * D1 Databases
	 * https://developers.cloudflare.com/d1/
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "api",
			"database_id": "bc62b597-a418-4e1b-a89d-65bda1564fec"
		}
	],
	"ai": {
		"binding": "AI"
	},
	/**
	 * Rate Limiting bindings — one per API type. Period is fixed by the
	 * Cloudflare runtime to 10 or 60 seconds; use per-minute budgets. Adjust
	 * `limit` here (not from an env var) — the binding does not accept dynamic
	 * limits. `namespace_id` is an opaque integer per binding, unique within
	 * this Worker (Cloudflare dashboard exposes shared namespaces if you need
	 * cross-worker aggregation, otherwise per-worker IDs are fine).
	 *
	 * Middleware fails open when a binding is missing (see
	 * apps/middlewares/rate-limit.middleware.ts) so removing one here disables
	 * that policy rather than crashing the request.
	 */
	"ratelimits": [
		{ "name": "RATE_LIMITER_AUTH",       "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RATE_LIMITER_READ",       "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RATE_LIMITER_WRITE",      "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RATE_LIMITER_ENGAGEMENT", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RATE_LIMITER_CONTACT",    "namespace_id": "1005", "simple": { "limit": 2, "period": 60 } }
	],
	/**
	 * Scheduled (Cron) Triggers
	 * https://developers.cloudflare.com/workers/configuration/cron-triggers/
	 *
	 * Every 5 minutes: promote articles whose `publish_at` (UTC, converted from
	 * Asia/Phnom_Penh) has elapsed. Handler exported as `scheduled` in apps/app.ts.
	 */
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}