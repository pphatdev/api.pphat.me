# =============================================================================
# api.pphat.me — env template
# =============================================================================
# Two ways this file is used:
#   1. Local dev: copy to `.dev.vars` (git-ignored). Values below become
#      available on `env` inside the Worker via wrangler dev.
#   2. Production: DO NOT ship secrets in wrangler.jsonc `vars`. Instead
#      provision each SECRET (marked ★ below) with `wrangler secret put NAME`
#      so the value is stored in the Cloudflare Secrets Store and never sits
#      on disk or in git history.
#
# When rotating a secret: rotate at the upstream provider first, then run
# `wrangler secret put <NAME>` to update the Worker. Never edit and commit
# the old value in this file — that leaks it to git history.
# =============================================================================


# ---- GitHub OAuth (★ CLIENT_SECRET is a secret) ---------------------------
# Get from https://github.com/settings/developers
# NOTE: keep the ID / SECRET on the correct fields — a swapped pair fails
# silently and every OAuth login returns "GitHub token exchange failed".
GITHUB_CLIENT_ID=Ov23li...            # public
GITHUB_CLIENT_SECRET=...              # ★ secret

# ---- Google OAuth (★ CLIENT_SECRET is a secret) ---------------------------
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=...apps.googleusercontent.com  # public
GOOGLE_CLIENT_SECRET=...              # ★ secret

# ---- JWT signing (★ secret) -----------------------------------------------
# Any long random string. Rotating this invalidates every session in flight,
# so users must re-authenticate. Access + refresh tokens both sign with this.
JWT_SECRET=a-long-random-string       # ★ secret

# ---- App URL (public) ------------------------------------------------------
# The origin the API is deployed at. Used in OAuth redirect URLs and (via
# https: prefix detection) to decide whether the refresh + oauth_state
# cookies are marked Secure.
APP_URL=http://localhost:8787


# ---- SMTP (★ SMTP_PASS is a secret) ---------------------------------------
# App-password from Gmail / SES / etc. Used by:
#   - Email OTP delivery (registration + login verification)
#   - Contact form owner notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info.sophat@gmail.com
SMTP_FROM="Sophat.L <info.sophat@gmail.com>"
SMTP_PASS=your-email-password         # ★ secret


# ---- Cloudflare API access (★ API_TOKEN is a secret) ----------------------
# Only used by helper scripts (db:pull-remote, db-studio) — NOT read by the
# Worker at runtime. Safe to omit in production.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=                 # ★ secret


# ---- IP hashing pepper (★ optional secret) --------------------------------
# When set, visitor_logs.ip_hash uses HMAC-SHA-256(ip, IP_HASH_SECRET). See
# #22 in SECURITY_FIX_PLAN.md. Without it, the middleware falls back to
# plain SHA-256 — brute-forceable against the IPv4 space.
#   wrangler secret put IP_HASH_SECRET
# IP_HASH_SECRET=another-long-random-string


# =============================================================================
# Configuration NOT set via env vars — pointers for the operator
# =============================================================================
# Rate limits (#7):
#   Configured on the Cloudflare Rate Limiting bindings in wrangler.jsonc,
#   inside the `ratelimits` array. Period is fixed at 60 seconds per binding.
#
# CORS allow-list (#23):
#   Explicit hostname array in apps/shared/config/cors.ts.
#
# Refresh + oauth_state cookies (#4, #14):
#   Marked Secure automatically when APP_URL starts with `https:`. In local
#   dev with `http://localhost`, Secure is dropped so the cookie still flows.
# =============================================================================


# =============================================================================
# Production provisioning checklist (run once per environment)
# =============================================================================
#   wrangler secret put GITHUB_CLIENT_SECRET
#   wrangler secret put GOOGLE_CLIENT_SECRET
#   wrangler secret put JWT_SECRET
#   wrangler secret put SMTP_PASS
#   wrangler secret put IP_HASH_SECRET     # optional but recommended
#
# Verify what's provisioned:
#   wrangler secret list
#
# Rotate a secret:
#   1. Regenerate at the upstream provider
#   2. wrangler secret put <NAME>
#   3. wrangler deployments list   # confirm new version is active
# =============================================================================
